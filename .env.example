# Database (SQLite file, created by `npx prisma db push`)
DATABASE_URL="file:./dev.db"

# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: only needed to test webhook signature verification
PAYPAL_WEBHOOK_ID=

# Sandbox PERSONAL account email that receives the payout
SELLER_PAYPAL_EMAIL=

# AI verification agent (gpt-oss-120b on Groq, console.groq.com)
GROQ_API_KEY=