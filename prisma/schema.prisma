datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  BUYER
  SELLER
  PLATFORM_ADMIN
}

enum ContractStatus {
  DRAFT
  NEGOTIATING
  LOCKED_IN_ESCROW
  IN_PROGRESS
  VERIFYING
  DISPUTED
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  FUNDED
  SUBMITTED
  VERIFIED
  RELEASED
  REFUNDED
}

enum EscrowStatus {
  CREATED
  APPROVED
  COMPLETED
  VOIDED
}

model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  name               String?
  role               Role       @default(BUYER)
  paypalPayerId      String?    @unique
  paypalReceiverEmail String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  
  buyerContracts     Contract[] @relation("BuyerContracts")
  sellerContracts    Contract[] @relation("SellerContracts")
}

model Contract {
  id              String         @id @default(uuid())
  title           String
  description     String
  status          ContractStatus @default(DRAFT)
  totalAmount     Decimal        
  currency        String         @default("USD")
  
  buyerId         String
  buyer           User           @relation("BuyerContracts", fields: [buyerId], references: [id])
  
  sellerId        String
  seller          User           @relation("SellerContracts", fields: [sellerId], references: [id])
  
  milestones      Milestone[]
  escrowState     EscrowState?
  agentLogs       AgentLog[]
  idempotencyKeys IdempotencyKey[]
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Milestone {
  id          String          @id @default(uuid())
  contractId  String
  contract    Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title       String
  amount      Decimal         
  status      MilestoneStatus @default(PENDING)
  deliverable String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model EscrowState {
  id                 String       @id @default(uuid())
  contractId         String       @unique
  contract           Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  paypalOrderId      String       @unique
  paypalCaptureId    String?      @unique
  paypalPayoutBatchId String?
  status             EscrowStatus @default(CREATED)
  amountLocked       Decimal      
  platformFeeAmount  Decimal      
  freelancerAmount   Decimal      
  rawPaypalPayload   String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model AgentLog {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  agentRole  String   @default("AGENT")
  agentType  String   @default("AGENT")
  action     String
  payload    String?
  reasoning  String   @default("")
  toolCalls  String?
  createdAt  DateTime @default(now())
}

model IdempotencyKey {
  id            String    @id @default(uuid())
  key           String    @unique
  requestHash   String
  responseBody  String?
  statusCode    Int?
  contractId    String?
  contract      Contract? @relation(fields: [contractId], references: [id])
  lockedAt      DateTime  @default(now())
  expiresAt     DateTime
}
